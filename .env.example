# Copy to .env and tweak. Anything left out (or blank) uses the default shown here.

# --- Run options (command-line flags override these) ---
CAMERA=0              # camera index
IMGSZ=640             # YOLO input size; lower = faster, less accurate
DEVICE=               # mps / cpu; blank = mps when available

# --- Duel rules (seconds unless noted) ---
LIVES=3                   # hearts per player; losing the last one loses the match
START_HOLD=1.0            # both players visible and not drawing this long to start a round
READY_TO_STEADY=1.5       # READY -> STEADY
BANG_DELAY_MIN=1.5        # STEADY -> BANG is random between these two
BANG_DELAY_MAX=5.0
DRAW_TIMEOUT=3.0          # after BANG, nobody draws in this time -> nobody scores
TIE_WINDOW=0.034          # draws this close are a tie (about 1 frame at 30 fps)
SETTLE_TIME=0.15          # after the first draw, wait this long for a possible tie
DRAW_CONFIRM_FRAMES=2     # frames a draw must hold before it counts (filters twitches)
ROUND_RESULT_TIME=3.0     # how long the shot / round result screen stays up
MATCH_RESULT_MIN_TIME=3.0 # winner screen shows at least this long before a rematch can start

# --- Draw pose detection ---
MIN_CONF=0.5          # keypoint confidence needed to trust shoulder/elbow/wrist
MIN_ELBOW_ANGLE=140.0 # degrees; 180 = perfectly straight arm
MAX_ARM_TILT=30.0     # degrees the arm may point away from horizontal

# --- Look ---
EARLY_FLOAT_TIME=2.0  # seconds for "too early" to drift up and vanish
EARLY_FADE_START=0.5  # fraction of that trip after which it starts fading
